# Copy this file to .env and fill in values. The runtime container loads it via `--env-file .env`.

# Required: OpenRouter API key for the LLM chat assistant.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key. If unset/empty, the built-in market simulator is used.
MASSIVE_API_KEY=

# Optional: Set to "true" to return deterministic mock LLM responses (useful for E2E tests / no-key dev).
LLM_MOCK=false
